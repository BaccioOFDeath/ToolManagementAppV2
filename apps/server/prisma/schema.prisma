generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String       @id @default(uuid()) @map("id")
  tenantId  String       @map("tenant_id")
  code      String       @map("code")
  name      String       @map("name")
  metadata  Json?        @default("{}") @map("metadata")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  departments Department[]

  @@unique([tenantId, code], name: "branch_code_per_tenant")
  @@index([tenantId], name: "branch_tenant_idx")
  @@map("Branch")
}

model Department {
  id                  String      @id @default(uuid()) @map("id")
  tenantId            String      @map("tenant_id")
  branchId            String?     @map("branch_id")
  code                String      @map("code")
  name                String      @map("name")
  parentDepartmentId  String?     @map("parent_department_id")
  metadata            Json?       @default("{}") @map("metadata")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parent     Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children   Department[] @relation("DepartmentHierarchy")
  roles      DepartmentRole[]
  assignments UserDepartmentAssignment[]

  @@unique([tenantId, code], name: "department_code_per_tenant")
  @@index([tenantId], name: "department_tenant_idx")
  @@index([branchId], name: "department_branch_idx")
  @@index([parentDepartmentId], name: "department_parent_idx")
  @@map("Department")
}

model RoleDefinition {
  id              String   @id @default(uuid()) @map("id")
  tenantId        String   @map("tenant_id")
  key             String   @map("key")
  displayName     String   @map("display_name")
  description     String?  @map("description")
  scope           String   @map("scope")
  permissions     Json     @map("permissions")
  inheritsFromIds String[] @default([]) @map("inherits_from_ids")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  departmentRoles DepartmentRole[]

  @@unique([tenantId, key], name: "role_key_per_tenant")
  @@index([tenantId], name: "role_definition_tenant_idx")
  @@map("RoleDefinition")
}

model DepartmentRole {
  id                String   @id @default(uuid()) @map("id")
  tenantId          String   @map("tenant_id")
  departmentId      String   @map("department_id")
  roleDefinitionId  String   @map("role_definition_id")
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  department  Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  definition  RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments UserDepartmentAssignment[]

  @@unique([departmentId, roleDefinitionId], name: "role_per_department")
  @@index([tenantId], name: "department_role_tenant_idx")
  @@index([departmentId], name: "department_role_department_idx")
  @@index([roleDefinitionId], name: "department_role_definition_idx")
  @@map("DepartmentRole")
}

model UserDepartmentAssignment {
  id               String   @id @default(uuid()) @map("id")
  tenantId         String   @map("tenant_id")
  userId           String   @map("user_id")
  departmentRoleId String   @map("department_role_id")
  departmentId     String   @map("department_id")
  isPrimary        Boolean  @default(false) @map("is_primary")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  removedAt        DateTime? @map("removed_at")

  departmentRole DepartmentRole @relation(fields: [departmentRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId, departmentRoleId], name: "user_role_per_tenant")
  @@index([tenantId], name: "assignment_tenant_idx")
  @@index([departmentId], name: "assignment_department_idx")
  @@index([departmentRoleId], name: "assignment_role_idx")
  @@index([userId], name: "assignment_user_idx")
  @@map("UserDepartmentAssignment")
}
