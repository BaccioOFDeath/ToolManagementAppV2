<!-- Resources/Colors.SDEuropeanLight.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Col.Background">#F2F2F2</Color>
    <Color x:Key="Col.BackgroundAlt">#FAFAFA</Color>
    <Color x:Key="Col.Surface">#FFFFFF</Color>
    <Color x:Key="Col.SurfaceAlt">#FAFAFA</Color>
    <Color x:Key="Col.Border">#D8D8D8</Color>
    <Color x:Key="Col.BorderAlt">#BDBDBD</Color>
    <Color x:Key="Col.Fg">#010101</Color>
    <Color x:Key="Col.FgMuted">#4A4A4A</Color>
    <Color x:Key="Col.Success">#1E7A3C</Color>
    <Color x:Key="Col.Error">#B3261E</Color>
    <Color x:Key="Col.Warning">#B36A00</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Col.Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Col.Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Col.SurfaceAlt}"/>
    <SolidColorBrush x:Key="BorderBrushBase" Color="{StaticResource Col.Border}"/>
    <SolidColorBrush x:Key="BorderBrushAlt" Color="{StaticResource Col.BorderAlt}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Col.Fg}"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource Col.FgMuted}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Col.Success}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Col.Error}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Col.Warning}"/>
    <Color x:Key="Col.Accent">#FFC326</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Col.Accent}"/>
    <Color x:Key="Col.OnAccent">#010101</Color>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="{StaticResource Col.OnAccent}"/>
    <Color x:Key="Col.CardBackground">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Col.CardBackground}"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="TransparentSurfaceBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#E8FFFFFF"/>
    <SolidColorBrush x:Key="GlassSurfaceAltBrush" Color="#D9F1F2F5"/>
    <SolidColorBrush x:Key="AppBackgroundTintBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ThemeShellHeaderBrush" Color="{StaticResource Col.Surface}"/>
    <SolidColorBrush x:Key="ThemeShellMenuBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="NavigationAltSurfaceBrush" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="PageHeaderDashboardBrush" Color="#EAF4FF"/>
    <SolidColorBrush x:Key="PageHeaderSearchBrush" Color="#EEF7F1"/>
    <SolidColorBrush x:Key="PageHeaderManageItemsBrush" Color="#FFF4D6"/>
    <SolidColorBrush x:Key="PageHeaderRentalsBrush" Color="#FFE8CC"/>
    <SolidColorBrush x:Key="PageHeaderCustomersBrush" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="PageHeaderReservationsBrush" Color="#F3E8FF"/>
    <SolidColorBrush x:Key="PageHeaderMaintenanceBrush" Color="#FFE7E7"/>
    <SolidColorBrush x:Key="PageHeaderCalibrationBrush" Color="#E6FAF8"/>
    <SolidColorBrush x:Key="PageHeaderKitsBrush" Color="#F1F5D8"/>
    <SolidColorBrush x:Key="PageHeaderCategoriesBrush" Color="#EDE7DD"/>
    <SolidColorBrush x:Key="PageHeaderReportsBrush" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="PageHeaderActivityLogsBrush" Color="#F0EBFF"/>
    <SolidColorBrush x:Key="PageHeaderImportExportBrush" Color="#E8F7FF"/>
    <SolidColorBrush x:Key="PageHeaderUsersBrush" Color="#F4EAF3"/>
    <SolidColorBrush x:Key="PageHeaderSettingsBrush" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#FFEEBF"/>
    <SolidColorBrush x:Key="NavButtonHoverBorderBrush" Color="#FFC326"/>
    <SolidColorBrush x:Key="NavButtonPressedBrush" Color="#FFC326"/>
    <SolidColorBrush x:Key="NavButtonPressedBorderBrush" Color="#D2990A"/>
    <SolidColorBrush x:Key="NavButtonDisabledBrush" Color="#F1F2F5"/>
    <SolidColorBrush x:Key="NavButtonDisabledBorderBrush" Color="#E2E4E8"/>
    <SolidColorBrush x:Key="BtnBg" Color="#FFC326"/>
    <SolidColorBrush x:Key="BtnBgHover" Color="#F2B211"/>
    <SolidColorBrush x:Key="BtnBorder" Color="#D2990A"/>
    <SolidColorBrush x:Key="BtnFg" Color="#010101"/>
    <SolidColorBrush x:Key="FocusVisualStrokeBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFEEBF"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFC326"/>
    <SolidColorBrush x:Key="ItemHoverForegroundBrush" Color="{StaticResource Col.Fg}"/>
    <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#010101"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#8B96A3"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F1F2F5"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#E2E4E8"/>
    <x:Array x:Key="UserInitialsBrushes" Type="SolidColorBrush">
        <SolidColorBrush Color="#FFF5B700"/>
        <SolidColorBrush Color="#FF0F0F0F"/>
        <SolidColorBrush Color="#FF1C1C1E"/>
        <SolidColorBrush Color="#FFC99500"/>
        <SolidColorBrush Color="#FF6B7280"/>
        <SolidColorBrush Color="#FF15803D"/>
        <SolidColorBrush Color="#FFDC2626"/>
        <SolidColorBrush Color="#FF3A506B"/>
    </x:Array>
</ResourceDictionary>
