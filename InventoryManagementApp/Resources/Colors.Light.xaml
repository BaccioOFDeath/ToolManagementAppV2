<!-- Resources/Colors.Light.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Col.Background">#FFF7F8FA</Color>
    <Color x:Key="Col.Surface">#FFFFFFFF</Color>
    <Color x:Key="Col.SurfaceAlt">#FFF0F1F3</Color>
    <Color x:Key="Col.Border">#FFDCDFe3</Color>
    <Color x:Key="Col.BorderAlt">#FFC8CDD6</Color>
    <Color x:Key="Col.Fg">#FF0D0D0D</Color>
    <Color x:Key="Col.FgMuted">#FF4B4B55</Color>
    <Color x:Key="Col.Success">#FF107C41</Color>
    <Color x:Key="Col.Error">#FFD92D20</Color>
    <Color x:Key="Col.Warning">#FFF59E0B</Color>
    <Color x:Key="Col.Info">#FF2B70FF</Color>
    <Color x:Key="Col.Brand">#FF010101</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Col.Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Col.Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Col.SurfaceAlt}"/>
    <SolidColorBrush x:Key="BorderBrushBase" Color="{StaticResource Col.Border}"/>
    <SolidColorBrush x:Key="BorderBrushAlt" Color="{StaticResource Col.BorderAlt}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Col.Fg}"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource Col.FgMuted}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Col.Success}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Col.Error}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Col.Warning}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Col.Info}"/>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Col.Brand}"/>
    <Color x:Key="Col.Accent">#FFFFC326</Color>
    <Color x:Key="Col.AccentHover">#FFFFD65C</Color>
    <Color x:Key="Col.AccentPressed">#FFE5B200</Color>
    <Color x:Key="Col.AccentSoft">#26FFC326</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Col.AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Col.AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Col.AccentSoft}"/>
    <Color x:Key="Col.OnAccent">#FF0D0D0D</Color>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="{StaticResource Col.OnAccent}"/>
    <Color x:Key="Col.CardBackground">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Col.CardBackground}"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="{StaticResource Col.Surface}"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="{StaticResource Col.SurfaceAlt}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="{StaticResource Col.AccentSoft}"/>
    <SolidColorBrush x:Key="NavButtonHoverBorderBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="NavButtonPressedBrush" Color="{StaticResource Col.AccentHover}"/>
    <SolidColorBrush x:Key="NavButtonPressedBorderBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="NavButtonDisabledBrush" Color="#FFE8E9EC"/>
    <SolidColorBrush x:Key="NavButtonDisabledBorderBrush" Color="#FFCED3DC"/>
    <SolidColorBrush x:Key="BtnBg" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="BtnBgHover" Color="{StaticResource Col.AccentHover}"/>
    <SolidColorBrush x:Key="BtnBorder" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="BtnFg" Color="{StaticResource Col.OnAccent}"/>
    <SolidColorBrush x:Key="FocusVisualStrokeBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource Col.AccentSoft}"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="{StaticResource Col.Accent}"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF9AA0AE"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFF2F4F7"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#FFF2F4F7"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#FFE6E9EF"/>
    <x:Array x:Key="UserInitialsBrushes" Type="SolidColorBrush">
        <SolidColorBrush Color="#FF2B70FF"/>
        <SolidColorBrush Color="#FF10A760"/>
        <SolidColorBrush Color="#FF4B4B55"/>
        <SolidColorBrush Color="#FFD92D20"/>
        <SolidColorBrush Color="#FFF59E0B"/>
        <SolidColorBrush Color="#FFFFC326"/>
        <SolidColorBrush Color="#FF2B4865"/>
        <SolidColorBrush Color="#FF010101"/>
    </x:Array>
</ResourceDictionary>
