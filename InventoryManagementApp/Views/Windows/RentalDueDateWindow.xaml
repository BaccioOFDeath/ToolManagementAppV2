<Window x:Class="InventoryManagementApp.Views.Windows.RentalDueDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extend Rental"
        Width="430"
        Height="260"
        MinWidth="390"
        MinHeight="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DesktopPaneHeader}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Extend Rental" Style="{StaticResource PageTitleTextBlock}"/>
                <TextBlock Text="Choose the exact due-back date for this rental job." Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current due" Style="{StaticResource LabelTextBlock}" Margin="0,0,10,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentDueText" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="New due" Style="{StaticResource LabelTextBlock}" Margin="0,0,10,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DueDatePicker"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DesktopSectionActionStrip}" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Save only after confirming the customer agreed to the new date." Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Save Date" Click="Save_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
