<Window x:Class="InventoryManagementApp.Views.Windows.ImageBackgroundRemovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Remove Image Background"
        Width="1160" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainContentBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Remove Background" Style="{StaticResource PageTitleTextBlock}"/>
                    <TextBlock Text="Move or resize the clip box, tune the background threshold, then save the transparent image." Style="{StaticResource CaptionTextBlock}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Clip Area" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushAlt}" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="ClipCanvas" SizeChanged="ClipCanvas_SizeChanged" Background="{DynamicResource SurfaceBrush}">
                            <Image x:Name="SourceImage" Stretch="Fill"/>
                            <Rectangle x:Name="DimOverlay" Fill="#66000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="ClipBorder" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Fill="#11FFFFFF" IsHitTestVisible="False"/>
                            <primitives:Thumb x:Name="MoveThumb" Cursor="SizeAll" Opacity="0.01" DragDelta="MoveThumb_DragDelta"/>
                            <primitives:Thumb x:Name="TopLeftThumb" Width="18" Height="18" Cursor="SizeNWSE" DragDelta="TopLeftThumb_DragDelta"/>
                            <primitives:Thumb x:Name="TopRightThumb" Width="18" Height="18" Cursor="SizeNESW" DragDelta="TopRightThumb_DragDelta"/>
                            <primitives:Thumb x:Name="BottomLeftThumb" Width="18" Height="18" Cursor="SizeNESW" DragDelta="BottomLeftThumb_DragDelta"/>
                            <primitives:Thumb x:Name="BottomRightThumb" Width="18" Height="18" Cursor="SizeNWSE" DragDelta="BottomRightThumb_DragDelta"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Transparent Preview" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrushAlt}" BorderThickness="1">
                        <Grid>
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFFFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,20,20"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFE2E5EA">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,10,10"/>
                                                        <RectangleGeometry Rect="10,10,10,10"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Background Threshold" Style="{StaticResource LabelTextBlock}"/>
                        <DockPanel LastChildFill="True" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="ThresholdSlider" Minimum="24" Maximum="150" Value="72" TickFrequency="6" IsSnapToTickEnabled="False" Height="32" VerticalAlignment="Center" ValueChanged="ThresholdSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DesktopSectionActionStrip}" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Reset Clip" Click="ResetClip_Click" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save Clipped Image" Click="Save_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
