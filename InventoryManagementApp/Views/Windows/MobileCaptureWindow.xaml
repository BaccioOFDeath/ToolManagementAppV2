<Window x:Class="InventoryManagementApp.Views.Windows.MobileCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mobile Capture"
        Width="520"
        Height="660"
        MinWidth="460"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="Mobile Capture" Style="{StaticResource HeadingTextBlock}"/>
                <TextBlock Text="Scan this QR code from a phone on the same Wi-Fi network to add item photos and rental before/after photos."
                           Style="{StaticResource CaptionTextBlock}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,12">
            <StackPanel>
                <Border Width="300"
                        Height="300"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrushAlt}"
                        BorderThickness="1"
                        Padding="10">
                    <Image Source="{Binding QrImage}" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="Phone URL" Style="{StaticResource LabelTextBlock}" Margin="0,18,0,4"/>
                <TextBox Text="{Binding Url, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="58"/>

                <Border Style="{StaticResource DesktopNoteCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding ExpiresDisplay}" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"/>
                        <TextBlock Text="If the phone cannot open the page, confirm both devices are on the same network and allow the app through Windows Firewall for private networks."
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}"
                    Content="Copy URL"
                    Command="{Binding CopyUrlCommand}"
                    MinWidth="110"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Close"
                    Command="{Binding CloseCommand}"
                    MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>
