<!-- Views/RentalsFilterWindow.xaml -->
<Window x:Class="InventoryManagementApp.Views.Windows.RentalsFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Rentals"
        Width="560" Height="430"
        MinWidth="520" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FilterFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="14,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Rental Filter" Style="{StaticResource PageTitleTextBlock}"/>
                    <TextBlock Text="Refine the rental desk by customer, item, date window, or checkout state before reviewing records."
                               Style="{StaticResource CaptionTextBlock}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource DesktopSummaryCard}" Width="145" Margin="14,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Filter State" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Text="Ready" Style="{StaticResource HeadingTextBlock}"/>
                        <TextBlock Text="Apply, clear, or close" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DesktopSummaryCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Search Scope" Style="{StaticResource LabelTextBlock}"/>
                    <TextBlock Text="{Binding SearchText, TargetNullValue=All rentals}" Style="{StaticResource HeadingTextBlock}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Customer, item number, contact, or handoff text" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource DesktopSummaryCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Status Scope" Style="{StaticResource LabelTextBlock}"/>
                    <TextBlock Text="{Binding SelectedStatus, TargetNullValue=Any status}" Style="{StaticResource HeadingTextBlock}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Pair with the date window before applying" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DesktopPaneHeader}">
                    <StackPanel>
                        <TextBlock Text="Rental Directory Criteria" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <TextBlock Text="Keep filters narrow enough for action, then clear them before broad directory review."
                                   Style="{StaticResource CaptionTextBlock}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Find rentals" Style="{StaticResource FilterFieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="30"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="From" Style="{StaticResource FilterFieldLabel}"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding FilterFrom}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="To" Style="{StaticResource FilterFieldLabel}"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding FilterTo}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource FilterFieldLabel}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              ItemContainerStyle="{StaticResource DropdownItemStyle}"
                              Margin="0,0,0,8"/>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DesktopNoteCard}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Filter Handoff" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Apply updates the rental directory immediately. Clear returns the desk to all visible rentals so follow-up actions do not inherit an old filter."
                                       Style="{StaticResource CaptionTextBlock}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource DesktopSectionActionStrip}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButton}" Width="104" Content="Apply" Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostButton}" Width="104" Content="Clear" Command="{Binding ClearFilterCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostButton}" Width="104" Content="Close" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DesktopStatusFooter}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Rental filters ready" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Search, dates, and status are preserved until Apply or Clear is selected."
                           Style="{StaticResource CaptionTextBlock}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
