<UserControl x:Class="InventoryManagementApp.Views.Pages.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushAlt}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Width="220"
                     MinWidth="160"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand, ElementName=Root}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2"
                    Style="{StaticResource GhostButton}"
                    Content="&#xE721;"
                    FontFamily="Segoe MDL2 Assets"
                    Width="28"
                    Height="24"
                    ToolTip="{Binding SearchLabel, ElementName=Root}"
                    Command="{Binding SearchCommand, ElementName=Root}"
                    Margin="6,0,0,0"/>
            <Button Grid.Column="3"
                    Content="&#xE10A;"
                    FontFamily="Segoe MDL2 Assets"
                    Width="28"
                    Height="24"
                    ToolTip="Clear"
                    Command="{Binding ClearCommand, ElementName=Root}"
                    Margin="6,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClearCommand, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
