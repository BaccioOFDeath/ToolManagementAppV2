<UserControl x:Class="InventoryManagementApp.Views.Pages.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushAlt}" BorderThickness="1" Padding="4,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SearchLabel, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchLabel, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     MinWidth="180"
                     HorizontalAlignment="Stretch"
                     Margin="0"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand, ElementName=Root}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Content="Find"
                    Width="68"
                    Command="{Binding SearchCommand, ElementName=Root}"
                    Margin="6,0,0,0"/>
            <Button Grid.Column="3"
                    Content="Clear"
                    Width="68"
                    Command="{Binding ClearCommand, ElementName=Root}"
                    Margin="6,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClearCommand, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
