<!-- Views/ActivityLogsPage.xaml -->
<Page x:Class="InventoryManagementApp.Views.Pages.ActivityLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4"/>
                    <TextBox Width="230"
                             MinWidth="160"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by user, action, type, destination, or timestamp"
                             Margin="0,0,8,4"/>

                    <TextBlock Text="User:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4"/>
                    <ComboBox ItemsSource="{Binding UserFilters}"
                              SelectedItem="{Binding SelectedUserFilter}"
                              MinWidth="150"
                              Width="165"
                              Margin="0,0,8,4"/>

                    <TextBlock Text="Action:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,4"/>
                    <ComboBox ItemsSource="{Binding ActionFilters}"
                              SelectedItem="{Binding SelectedActionFilter}"
                              MinWidth="160"
                              Width="175"
                              Margin="0,0,8,4"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,4,4"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,4,4"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Open Related"
                            Click="OpenRelatedPage_Click"
                            Margin="0,0,4,4"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Copy Handoff"
                            Click="CopySelectedLog_Click"
                            Margin="0,0,4,4"/>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Print"
                            Click="PrintLogs_Click"
                            Margin="0,0,0,4"/>
                </WrapPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding ActivitySummary}"
                           Style="{StaticResource CaptionTextBlock}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.45*" MinWidth="430"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1.2*" MinWidth="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ActivityGrid"
                          ItemsSource="{Binding FilteredLogs}"
                          SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          Style="{StaticResource VirtualizedDataGridStyle}"
                          MouseDoubleClick="ActivityGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ActivityGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Activity Detail" Click="OpenSelectedLog_Click"/>
                            <MenuItem Header="Open Related Page" Click="OpenRelatedPage_Click"/>
                            <MenuItem Header="Copy Handoff" Click="CopySelectedLog_Click"/>
                            <Separator/>
                            <MenuItem Header="Print Current Results" Click="PrintLogs_Click"/>
                            <MenuItem Header="Refresh" Click="RefreshLogs_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp"
                                            Binding="{Binding Timestamp, Converter={StaticResource DateTimeMinToEmptyStringConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=''}"
                                            Width="145"/>
                        <DataGridTextColumn Header="User"
                                            Binding="{Binding UserName}"
                                            Width="130"/>
                        <DataGridTextColumn Header="User ID"
                                            Binding="{Binding UserID}"
                                            Width="64"/>
                        <DataGridTextColumn Header="Action"
                                            Binding="{Binding Action}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrushBase}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource DesktopSummaryCard}"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Selected Activity" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding SelectedLogTitle}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedLogTimestamp}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLogActionGroup}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource DesktopNoteCard}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Audit Handoff" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding SelectedLogNextAction}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLogDestinationName, StringFormat=Destination: {0}}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activity Detail" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel Grid.Row="1" Margin="0,4,0,5">
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Open Detail"
                                    Click="OpenSelectedLog_Click"
                                    Margin="0,0,4,4"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Open Related"
                                    Click="OpenRelatedPage_Click"
                                    Margin="0,0,4,4"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Copy Handoff"
                                    Click="CopySelectedLog_Click"
                                    Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBox Grid.Row="2"
                                 Text="{Binding SelectedLogHandoff, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,3,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource DesktopSummaryCard}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Operator Path" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding SelectedLogOperatorPath}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrushAlt}"
                BorderThickness="1,0,1,1"
                Padding="6,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding FilteredLogCount, StringFormat='Visible: {0}'}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalLogCount, StringFormat='Loaded: {0}'}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding LastLoadedText, StringFormat='Last refresh: {0}'}" FontSize="11"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
