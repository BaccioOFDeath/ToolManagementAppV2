<Page x:Class="InventoryManagementApp.Views.KitManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:viewmodels="clr-namespace:InventoryManagementApp.ViewModels"
      xmlns:converters="clr-namespace:InventoryManagementApp.Converters"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=viewmodels:KitManagementViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Kit Management">
    <Page.Resources>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Kits List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add Kit" Command="{Binding AddKitCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"/>
                <Button Content="Edit Kit" Command="{Binding EditKitCommand}" Margin="0,0,5,0"/>
                <Button Content="Delete Kit" Command="{Binding DeleteKitCommand}" Margin="0,0,5,0"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kit Number" Binding="{Binding KitNumber}" Width="*"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- Right Panel: Kit Items -->
        <Grid Grid.Column="2" DataContext="{Binding SelectedKit}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add Item" Command="{Binding DataContext.AddItemToKitCommand, RelativeSource={RelativeSource AncestorType=Page}}" IsEnabled="{Binding DataContext.SelectedKit, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource NotNullToBoolConverter}}"/>
                <Button Content="Remove Item" Command="{Binding DataContext.RemoveItemFromKitCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding SelectedItem, ElementName=kitItemsGrid}" Margin="5,0,0,0" IsEnabled="{Binding SelectedItem, ElementName=kitItemsGrid, Converter={StaticResource NotNullToBoolConverter}}"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="kitItemsGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="*"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>