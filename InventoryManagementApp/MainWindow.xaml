<!-- MainWindow.xaml -->
<Window x:Class="InventoryManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InventoryManagementApp.Controls"
        xmlns:pages="clr-namespace:InventoryManagementApp.Views.Pages"
        Title="{Binding WindowTitle}" Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition x:Name="SidebarColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="True">
                                <Setter Property="Width" Value="220"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ActivityBar" Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,0,1,0">
            <DockPanel Margin="6,8">
                <StackPanel DockPanel.Dock="Top">
                    <ToggleButton x:Name="SidebarToggle"
                                  Style="{StaticResource SidebarToggleButton}"
                                  IsChecked="{Binding IsSidebarOpen, Mode=TwoWay}"
                                  ToolTip="Toggle menu"/>
                    <ToggleButton Style="{StaticResource ActivityToggleButton}"
                                  Content="&#xE80F;"
                                  Command="{Binding SelectOverviewSectionCommand}"
                                  IsChecked="{Binding IsOverviewSelected, Mode=OneWay}"
                                  ToolTip="Overview"/>
                    <ToggleButton Style="{StaticResource ActivityToggleButton}"
                                  Content="&#xE7C3;"
                                  Command="{Binding SelectOperationsSectionCommand}"
                                  IsChecked="{Binding IsOperationsSelected, Mode=OneWay}"
                                  ToolTip="Operations"/>
                    <ToggleButton Style="{StaticResource ActivityToggleButton}"
                                  Content="&#xE9D2;"
                                  Command="{Binding SelectInsightsSectionCommand}"
                                  IsChecked="{Binding IsInsightsSelected, Mode=OneWay}"
                                  ToolTip="Insights"/>
                    <ToggleButton Style="{StaticResource ActivityToggleButton}"
                                  Content="&#xE8F1;"
                                  Command="{Binding SelectDataSectionCommand}"
                                  IsChecked="{Binding IsDataSelected, Mode=OneWay}"
                                  ToolTip="Data"
                                  Visibility="{Binding IsDataSectionVisible, Converter={StaticResource BoolToVis}}"/>
                    <ToggleButton Style="{StaticResource ActivityToggleButton}"
                                  Content="&#xE713;"
                                  Command="{Binding SelectAdminSectionCommand}"
                                  IsChecked="{Binding IsAdminSelected, Mode=OneWay}"
                                  ToolTip="Admin"
                                  Visibility="{Binding IsAdminSectionVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource ActivityButton}" Content="&#xE74D;" Command="{Binding ExitCommand}" ToolTip="Exit"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="SidebarPanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,0,1,0">
            <Grid Margin="10,10,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Image Source="{Binding CompanyLogoPath, Converter={StaticResource NullToDefaultImageConverter}, ConverterParameter=logo}" Width="28" Height="28" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource HeadingTextBlock}"/>
                        <TextBlock Text="{Binding CurrentNavSectionTitle}" Style="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              PreviewMouseWheel="LeftNavScrollViewer_PreviewMouseWheel"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                    <ItemsControl ItemsSource="{Binding CurrentNavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Content="{Binding Title}"
                                        Command="{Binding Command}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushAlt}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="8">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Quick tips" Style="{StaticResource CaptionTextBlock}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" Padding="10,8" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPageTitle}" VerticalAlignment="Center" Style="{StaticResource PageTitleTextBlock}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <pages:SearchBar x:Name="GlobalSearchBar"
                                         Text="{Binding GlobalSearchText}"
                                         SearchCommand="{Binding GlobalSearchCommand}"
                                         SearchLabel="Search"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Margin="0,0,6,0">
                            <controls:UserAvatar UserName="{Binding CurrentUserName}"
                                                  UserPhotoPath="{Binding CurrentUserPhotoPath}"
                                                  Foreground="{Binding CurrentUserInitialsBrush}"
                                                  FontSize="14"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentUserRole}" Style="{StaticResource CaptionTextBlock}"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Switch" Command="{Binding SwitchUserCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame Grid.Row="1"
                   Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"
                   Background="{DynamicResource BackgroundBrush}"
                   Content="{Binding CurrentPage}"
                   Margin="{StaticResource PagePadding}"/>
        </Grid>
    </Grid>
</Window>
