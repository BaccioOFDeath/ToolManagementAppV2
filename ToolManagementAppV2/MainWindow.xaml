<Window x:Class="ToolManagementAppV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Inventory Management"
        Height="750" Width="1600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#DDD" Padding="10">
            <Button Content="Dashboard" Command="{Binding OpenDashboardCommand}" Margin="5"/>
            <Button Content="Tool Search" Command="{Binding OpenSearchToolsCommand}" Margin="5"/>
            <Button Content="Tool Management" Command="{Binding OpenManageToolsCommand}" Margin="5"
                    Visibility="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Rentals" Command="{Binding OpenRentalsCommand}" Margin="5"/>
            <Button Content="Customers" Command="{Binding OpenCustomersCommand}" Margin="5"/>
            <Button Content="Users" Command="{Binding OpenUsersCommand}" Margin="5"
                    Visibility="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="5"
                    Visibility="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Import/Export" Command="{Binding OpenImportExportCommand}" Margin="5"
                    Visibility="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Activity Logs" Command="{Binding OpenActivityLogsCommand}" Margin="5"/>
            <Button Content="Reports" Command="{Binding OpenReportsCommand}" Margin="5"/>
        </StackPanel>
        <Frame Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
