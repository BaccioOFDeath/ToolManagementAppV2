<!-- Views/RentalsPage.xaml -->
<Page x:Class="ToolManagementAppV2.Views.RentalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding RentalSearch, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Find" Command="{Binding SearchRentalsCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="New Rental" Command="{Binding NewRentalCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ActiveRentals}" SelectedItem="{Binding SelectedRental}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tool #" Binding="{Binding ToolNumber}" Width="120"/>
                    <DataGridTextColumn Header="Tool" Binding="{Binding ToolName}" Width="*"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="220"/>
                    <DataGridTextColumn Header="Out" Binding="{Binding DateOut, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="180"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="180"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
