<!-- Views/ImportExportPage.xaml -->
<Page x:Class="ToolManagementAppV2.Views.ImportExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Import Tools CSV" Command="{Binding ImportToolsCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Export Tools CSV" Command="{Binding ExportToolsCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Import Customers CSV" Command="{Binding ImportCustomersCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Export Customers CSV" Command="{Binding ExportCustomersCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ImportExportLogs}" IsReadOnly="True" AutoGenerateColumns="True"/>
        </Border>
    </Grid>
</Page>
