<!-- Views/ToolSearchPage.xaml -->
<Page x:Class="ToolManagementAppV2.Views.ToolSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedTool}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tool #" Binding="{Binding ToolNumber}" Width="120"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1,1,0,0" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected:" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedTool.Name}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Rent" Command="{Binding RentSelectedCommand}" Margin="12,0,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Open" Command="{Binding OpenSelectedCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
