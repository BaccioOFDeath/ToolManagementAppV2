<!-- Views/ReportsPage.xaml -->
<Page x:Class="ToolManagementAppV2.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="260" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReport}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Run" Command="{Binding RunReportCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ReportResults}" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Border>
    </Grid>
</Page>
